# Web app settings. Copy to `apps/web/.env.local` and fill in values. Never commit `.env.local`.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so restart `next dev`
# or rebuild after changing them, and never put secrets in them.

# Base URL of the ReadyBid API, read on the server at request time (status panel).
API_URL=http://localhost:8000

# Required for sign-in and the tenders pages: the browser calls the API directly with the
# user's access token. Add this web app's origin (e.g. http://localhost:3000) to the API's
# CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and PUBLIC anon key (Project Settings > API). Used for sign-in only.
# Never use the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
