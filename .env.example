# API and worker settings. Copy to `.env` in the repository root and fill in values.
# Never commit `.env`. Empty values are treated as "Integration not configured".

APP_ENV=development

# Comma-separated browser origins allowed to call the API. The web app calls the API
# directly from the browser, so its origin must be listed. No wildcards.
CORS_ORIGINS=http://localhost:3000

# Supabase dev project (Project Settings > API). The service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only for projects still using the legacy HS256 JWT secret. Leave empty to verify
# tokens against the project's JWKS signing keys.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Upstash Redis TCP connection string (TLS), e.g. rediss://default:<password>@<name>.upstash.io:6379
# Use the rediss:// URL, not the REST URL or token. Server-only: never expose it to the web app.
REDIS_URL=

# Upload limits. Keep MAX_UPLOAD_BYTES <= the bucket's file_size_limit (15 MB in the migration).
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=100

# Lifetime of signed download and source URLs, in seconds (10-3600).
SIGNED_URL_TTL_SECONDS=120

# Model call bounds. LLM_MAX_REPAIR_ATTEMPTS is capped at 2.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_COMPLETION_TOKENS=4096
LLM_MAX_REPAIR_ATTEMPTS=2
LLM_MAX_REQUIREMENTS_PER_GROUP=40

# Analysis runs over bounded page groups across the whole document.
ANALYSIS_PAGES_PER_GROUP=4
ANALYSIS_MAX_GROUP_CHARS=24000
ANALYSIS_BOUNDARY_CONTEXT_CHARS=600

# Background job bounds.
JOB_TIMEOUT_SECONDS=900
JOB_MAX_RETRIES=2
# Worker scheduler polling interval (1-60 s). Higher values use fewer Redis commands.
RQ_SCHEDULER_INTERVAL_SECONDS=10
